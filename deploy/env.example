# FOSShowcase runtime environment — copy to the canonical source
# ~/.foscs/fosshowcase/.env (mode 600), then replace each __set_me__.
#
# These keys are EXACTLY the variables docker-compose.yml interpolates (${VAR});
# do not rename them. Keep each value ALONE on its line with NO inline comment —
# Compose strips " # ..." inline comments, but anything that reads .env naively
# (or copies a value by hand) will pick up the comment. Comments go on their own
# lines, like these.

LOG_LEVEL=info
DATABASE_HOST=10.1.2.158

# openclaw_webhook role password (= OPENCLAW_WEBHOOK_PASSWORD in ~/.openclaw/.env)
POSTGRES_WEBHOOK_PASSWORD=__set_me__

# openclaw_admin role password (= OPENCLAW_ADMIN_PASSWORD in ~/.openclaw/.env)
POSTGRES_ADMIN_PASSWORD=__set_me__

# TradingView webhook shared secret, compared as plaintext (= WEBHOOK_SECRET in ~/.openclaw/.env)
WEBHOOK_SECRET=__set_me__
