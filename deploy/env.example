# FOSShowcase runtime environment — copy to the canonical source
# ~/.foscs/fosshowcase/.env (mode 600), then fill the __set_me__ values.
#
# These keys are EXACTLY the variables docker-compose.yml interpolates
# (${VAR}); do not rename them. The compose file maps them to the
# container's DATABASE_PASSWORD / MIGRATION_DATABASE_PASSWORD env vars,
# and hardcodes DATABASE_PORT/NAME/USER + MIGRATION_DATABASE_USER itself.
LOG_LEVEL=info
DATABASE_HOST=10.1.2.158
POSTGRES_WEBHOOK_PASSWORD=__set_me__   # openclaw_webhook role  (= OPENCLAW_WEBHOOK_PASSWORD in ~/.openclaw/.env)
POSTGRES_ADMIN_PASSWORD=__set_me__     # openclaw_admin role    (= OPENCLAW_ADMIN_PASSWORD in ~/.openclaw/.env)
WEBHOOK_SECRET=__set_me__              # TradingView webhook HMAC
