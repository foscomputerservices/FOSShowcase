<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.foscs.postgres-stale-lock</string>

    <!-- Clears a stale postmaster.pid after an unclean host reboot so the
         Homebrew postgresql@18 service (KeepAlive, retries every 10 s) can
         start. Runs once at login/boot and then every 5 minutes; a no-op
         while postgres is healthy. See deploy/postgres-clear-stale-lock.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/david/.foscs/scripts/postgres-clear-stale-lock.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/david/.foscs/postgres-stale-lock.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/david/.foscs/postgres-stale-lock.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/david</string>
    </dict>
</dict>
</plist>
